{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "编译 Just_Lilith.Core 与 Just_Lilith.Unity（Release）",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "package",
            "detail": "编译并生成 dist\\Just_Lilith-<版本>.zip 发布包",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1",
                "-Package"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "install",
            "detail": "编译并覆盖到游戏插件目录（先备份旧 DLL）",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1",
                "-Install"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
